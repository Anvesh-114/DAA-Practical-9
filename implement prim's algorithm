#include <iostream>
#include <climits>
using namespace std;

#define V 5

// Find the vertex with the minimum key value
int findMinVertex(int key[], bool visited[])
{
    int min = INT_MAX;
    int minIndex = -1;

    for (int i = 0; i < V; i++)
    {
        if (!visited[i] && key[i] < min)
        {
            min = key[i];
            minIndex = i;
        }
    }

    return minIndex;
}

// Prim's Algorithm
void prim(int graph[V][V])
{
    int parent[V];      // Stores the MST
    int key[V];         // Minimum edge weight
    bool visited[V];    // Tracks included vertices

    // Initialize all vertices
    for (int i = 0; i < V; i++)
    {
        key[i] = INT_MAX;
        visited[i] = false;
        parent[i] = -1;
    }

    // Start from vertex 0
    key[0] = 0;

    // MST contains V-1 edges
    for (int count = 0; count < V - 1; count++)
    {
        // Pick the vertex with minimum key
        int u = findMinVertex(key, visited);

        // Include it in MST
        visited[u] = true;

        // Update adjacent vertices
        for (int v = 0; v < V; v++)
        {
            if (graph[u][v] != 0 &&
                !visited[v] &&
                graph[u][v] < key[v])
            {
                parent[v] = u;
                key[v] = graph[u][v];
            }
        }
    }

    // Print MST
    cout << "Edge \tWeight\n";

    int totalWeight = 0;

    for (int i = 1; i < V; i++)
    {
        cout << parent[i] << " - " << i
             << "\t" << graph[i][parent[i]] << endl;

        totalWeight += graph[i][parent[i]];
    }

    cout << "Total weight = " << totalWeight << endl;
}

int main()
{
    int graph[V][V] =
    {
        {0, 2, 0, 6, 0},
        {2, 0, 3, 8, 5},
        {0, 3, 0, 0, 7},
        {6, 8, 0, 0, 9},
        {0, 5, 7, 9, 0}
    };

    prim(graph);

    return 0;
}
